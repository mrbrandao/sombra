# Copy to `.env` and fill in your real values. The `.env` file is ignored by
# git. Secrets are only ever read from the environment — never hardcoded.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   podman-compose up -d --build

# Key for the remote LLM provider (OpenCode Zen API).
OPENCODE_ZEN_API_KEY=

# Local master key used to authenticate clients against the LiteLLM proxy.
LITELLM_MASTER_KEY=sk-litellm-secret-key-1234